# Packaged importer sample: albedo, tangent-space normal and matte opacity maps.
newmtl ShardMetal
Kd 0.82 0.63 0.32
Ke 0.018 0.008 0.002
Ns 96
Pm 0.68
Pr 0.26
map_Kd -clamp on -s 1.25 1.25 1 -o 0.05 0.0 0 orbital_shard_albedo.tga
map_Ke -mm 0.0 1.0 -s 1.25 1.25 1 -o 0.05 0.0 0 orbital_shard_albedo.tga
norm -s 1.25 1.25 1 -o 0.05 0.0 0 orbital_shard_normal.tga
map_d -imfchan m -s 1.25 1.25 1 -o 0.05 0.0 0 -clamp on -mm 0.02 0.96 orbital_shard_opacity.tga
